NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://aquiayudamosve:aquiayudamosve_dev_pw@localhost:3306/aquiayudamosve"

# CORS: frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# JWT secrets — generate real random values for anything beyond local dev.
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Trust score: hours without confirmation before a report starts decaying
STALE_HOURS_THRESHOLD=6

# Supabase Storage (S3-compatible) — stores evidence photos uploaded to reports.
# Only required when actually uploading a photo (POST /api/reports/:id/evidence);
# see README.md "Despliegue" for how to create the bucket, S3 keys, and public URL.
STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>

# Notificaciones push del navegador (avisos de reportes críticos nuevos).
# Opcional — sin esto, /api/push/vapid-public-key devuelve 404 y el frontend
# simplemente no ofrece la opción de activarlas. Generar con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:contacto@aquiayudamosve.org
