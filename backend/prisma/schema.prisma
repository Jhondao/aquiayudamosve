// AquiAyudamosVE — Prisma schema
// Modular monolith, MySQL. See PROMPT MAESTRO section 17 for the table list this maps to.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  citizen
  moderator
  admin
}

enum ReputationLevel {
  nuevo
  colaborador
  colaborador_confiable
  voluntario_verificado
  organizacion
  entidad_institucional
}

enum CategoryGroup {
  ayuda
  necesidad
  critico
  info
}

enum ReportStatus {
  active
  inactive
  hidden
}

enum ConfirmationType {
  confirm
  unsure
  incorrect
}

enum NeedStatus {
  necesitamos
  en_camino
  parcialmente_cubierto
  cubierto
  excedente
  desactualizado
}

// ACTUALIZACIÓN DEL PROMPT MAESTRO — cómo se obtuvo el pin de un reporte,
// no si existe (todo reporte siempre tiene lat/lng reales). gps: geolocalización
// del navegador. catalog: eligió departamento/municipio del catálogo y el
// mapa embebido centró ahí. manual: escribió departamento/municipio libremente.
enum LocationSource {
  gps
  catalog
  manual
}

// PROMPT MAESTRO v3, Fase A — ledger de promesas de ayuda, separado de
// Report.quantityReceived a propósito (sección 5: nunca sumar
// automáticamente algo comprometido como recibido).
enum CommitmentStatus {
  committed
  on_the_way
  delivered
  cancelled
}

// PROMPT MAESTRO — COMPARTIR REPORTES CONFIRMADOS POR WHATSAPP. Telemetría
// mínima de qué canal se usó para compartir, nunca destinatarios ni números
// (sección "ShareEvent" del documento).
enum ShareChannel {
  whatsapp
  web_share
  copy_link
  save_image
}

// PROMPT MAESTRO — MÓDULO COMUNITARIO DE MASCOTAS, Fase 1. Qué tipo de
// reporte es (fijo desde que se crea) — distinto de PetStatus, que es el
// estado mutable del ciclo de vida (ver abajo).
enum PetReportType {
  lost
  found
  injured
  needs_help
}

enum PetSpecies {
  dog
  cat
  bird
  rabbit
  horse
  other
}

enum PetSex {
  male
  female
  unknown
}

enum PetSize {
  small
  medium
  large
}

// Incluye possible_match desde ya aunque ningún código de Fase 1 lo asigne
// todavía (eso es Fase 2, sugerencias automáticas de coincidencia) — se
// agrega ahora para no necesitar una migración nueva solo por un valor de
// enum cuando llegue esa fase.
enum PetStatus {
  lost
  sighted
  sheltered
  possible_match
  found
  reunited
  needs_help
  closed
  outdated
}

// Solo relevante cuando PetReportType es needs_help (o injured, para el
// caso "necesita atención veterinaria urgente").
enum PetHelpCategory {
  veterinary
  food
  water
  transport
  shelter
  rescue
  other
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  phone             String?
  // Null for accounts auto-created from a guest report (email + phone, no
  // password) — see lib/guestIdentity.ts#resolveGuestContact. isGuest tells
  // login/register apart from a real account sharing the same email.
  passwordHash      String?
  isGuest           Boolean  @default(false)
  displayName       String
  role              UserRole @default(citizen)
  organizationId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  organization      Organization?      @relation(fields: [organizationId], references: [id])
  reports           Report[]           @relation("ReportCreatedBy")
  confirmations     ReportConfirmation[]
  evidence          ReportEvidence[]
  updates           ReportUpdate[]
  flagsRaised       ReportFlag[]       @relation("FlagRaisedBy")
  needCommitments   NeedCommitment[]
  shareEvents       ShareEvent[]
  petReports        PetReport[]        @relation("PetReportCreatedBy")
  petShareEvents    PetShareEvent[]
  petConfirmations  PetConfirmation[]
  petSightings      PetSighting[]
  petResources      PetResource[]      @relation("PetResourceCreatedBy")
  moderationActions ModerationAction[] @relation("ModerationActor")
  auditLogs         AuditLog[]         @relation("AuditActor")
  sessions          Session[]
  securityEvents    SecurityEvent[]
  reputation        UserReputation?

  @@index([organizationId])
  @@index([email])
}

model UserReputation {
  userId    String          @id
  score     Int             @default(0)
  level     ReputationLevel @default(nuevo)
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  members OrganizationMember[]
  users   User[]
  reports Report[]             @relation("ReportOrganization")

  @@index([verified])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model ReportCategory {
  id       String        @id @default(uuid())
  group    CategoryGroup
  key      String        @unique
  label    String
  active   Boolean       @default(true)
  sortOrder Int          @default(0)

  reports Report[]
}

model Report {
  id                 String       @id @default(uuid())
  categoryId         String
  title              String
  description        String       @db.Text
  // ACTUALIZACIÓN DEL PROMPT MAESTRO — cobertura nacional en vez de solo
  // Cali. Texto libre, nunca contra un catálogo/enum (ver
  // reports.schemas.ts): el backend nunca bloquea una publicación porque el
  // lugar no esté en una lista predeterminada.
  departmentName     String
  municipalityName   String
  // Vereda/corregimiento/barrio + su nombre juntos (ej. "Vereda El Jardín")
  // — nunca separado en tipo+nombre, nada en el producto filtra por eso.
  localityName       String?
  locationSource     LocationSource @default(catalog)
  // Punto de referencia libre y opcional ("cerca al puente verde"). Antes
  // era obligatorio y el único texto de ubicación; con
  // departamento/municipio/localidad ya estructurados, forzarlo siempre
  // pediría el mismo dato dos veces.
  approxLocationText String?
  lat                Float
  lng                Float
  status             ReportStatus @default(active)
  trustScore         Int          @default(20)
  createdById        String
  organizationId     String?
  isSensitive        Boolean      @default(false)
  // Fase 1 del PROMPT MAESTRO — solo relevantes cuando category.group es
  // "necesidad" (NULL para el resto, igual que isSensitive con sus 3
  // categoryKey de docenas). Sin @default en needStatus: el service decide
  // el valor explícitamente por categoría, un DEFAULT de columna lo
  // filtraría a todo Report.create() que no lo mande.
  needStatus         NeedStatus?
  quantityNeeded     Float?
  quantityUnit       String?
  quantityReceived   Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lastConfirmedAt    DateTime     @default(now())
  deletedAt          DateTime?

  category      ReportCategory       @relation(fields: [categoryId], references: [id])
  createdBy     User                 @relation("ReportCreatedBy", fields: [createdById], references: [id])
  organization  Organization?        @relation("ReportOrganization", fields: [organizationId], references: [id])
  confirmations ReportConfirmation[]
  evidence      ReportEvidence[]
  updates       ReportUpdate[]
  flags         ReportFlag[]
  needCommitments NeedCommitment[]
  shareEvents   ShareEvent[]

  @@index([departmentName, municipalityName])
  @@index([categoryId])
  @@index([status])
  @@index([lat, lng])
  @@index([createdAt])
}

model ReportConfirmation {
  id        String           @id @default(uuid())
  reportId  String
  userId    String
  type      ConfirmationType
  approxLat Float?
  approxLng Float?
  createdAt DateTime         @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([reportId])
  @@index([userId])
  @@unique([reportId, userId, type])
}

model ReportEvidence {
  id             String   @id @default(uuid())
  reportId       String
  userId         String
  imageUrl       String?
  sourceUrl      String?
  relatedOrgName String?
  createdAt      DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([reportId])
}

model ReportUpdate {
  id        String   @id @default(uuid())
  reportId  String
  userId    String
  text      String
  deactivates Boolean @default(false)
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([reportId])
}

model ReportFlag {
  id        String   @id @default(uuid())
  reportId  String
  userId    String
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation("FlagRaisedBy", fields: [userId], references: [id])

  @@index([reportId])
}

model NeedCommitment {
  id               String           @id @default(uuid())
  reportId         String
  userId           String
  quantity         Float
  unit             String?
  status           CommitmentStatus @default(committed)
  estimatedArrival DateTime?
  transportMethod  String?
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([reportId])
  @@index([userId])
}

// Telemetría best-effort de compartir (nunca bloquea la UI si falla, mismo
// criterio que broadcastPush) — no se agrega al include de reportWithRelations,
// nunca se sirve junto al reporte, solo se escribe.
model ShareEvent {
  id        String       @id @default(uuid())
  reportId  String
  userId    String?
  channel   ShareChannel
  createdAt DateTime     @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([reportId])
}

model ModerationAction {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  admin User @relation("ModerationActor", fields: [adminId], references: [id])

  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
}

// Suscripción a notificaciones push del navegador — no requiere cuenta
// (mismo criterio que reportar sin login): cualquier visitante puede
// activarlas desde su dispositivo.
model PushSubscription {
  id        String   @id @default(uuid())
  // Los endpoints reales (sobre todo los de Apple, web.push.apple.com)
  // suelen pasar los 191 caracteres que Prisma usa por defecto para String
  // — con eso, el insert fallaba con un 500 real, no un error de validación.
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// PROMPT MAESTRO — MÓDULO COMUNITARIO DE MASCOTAS, Fase 1 (Fase 2 agrega
// confirmations/sightings abajo). Deliberadamente sigue sin trustScore/decay
// como el de Report — solo se cuenta confirm/incorrect al leer
// (pets.service.ts), sin score 0-100 ni decaimiento por tiempo.
model PetReport {
  id                  String           @id @default(uuid())
  reportType          PetReportType
  species             PetSpecies
  name                String?
  breed               String?
  sex                 PetSex           @default(unknown)
  size                PetSize?
  primaryColor        String?
  distinctiveFeatures String?          @db.Text
  description         String           @db.Text
  imageUrl            String?
  status              PetStatus
  // Solo relevantes cuando reportType = needs_help (o injured para
  // isEmergency) — el resto queda NULL, mismo patrón que needStatus en Report.
  helpCategory        PetHelpCategory?
  isEmergency         Boolean?
  departmentName      String
  municipalityName    String
  localityName        String?
  approxLocationText  String?
  lat                 Float
  lng                 Float
  locationSource      LocationSource   @default(manual)
  // "vista por última vez" (perdida) o "encontrada el" (encontrada) —
  // opcional porque alguien angustiado puede no recordar la hora exacta.
  happenedAt          DateTime?
  // true = el reportante tiene al animal consigo — dispara coarsenCoordinates
  // en pets.service.ts, igual que isSensitive en Report: nunca se persiste
  // la dirección exacta de una vivienda privada.
  isSheltered         Boolean          @default(false)
  // Visibilidad de moderación (hide/unhide), separada a propósito de
  // `status` — ese es el ciclo de vida real de la mascota (lost/found/
  // reunited/...), mezclar "oculto por un moderador" ahí lo conflictuaría.
  // Mismo patrón que Report.status: "hidden", pero como campo aparte porque
  // PetStatus ya está ocupado con otro significado.
  hidden              Boolean          @default(false)
  createdById         String
  lastConfirmedAt     DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  createdBy     User              @relation("PetReportCreatedBy", fields: [createdById], references: [id])
  shareEvents   PetShareEvent[]
  confirmations PetConfirmation[]
  sightings     PetSighting[]

  @@index([departmentName, municipalityName])
  @@index([status])
  @@index([lat, lng])
  @@index([createdAt])
}

// Modelo propio, no una generalización de ShareEvent — ese ya tiene una FK
// dura a Report; convertirlo a polimórfico tocaría una tabla que ya
// funciona por una ganancia mínima a esta escala.
model PetShareEvent {
  id          String       @id @default(uuid())
  petReportId String
  userId      String?
  channel     ShareChannel
  createdAt   DateTime     @default(now())

  petReport PetReport @relation(fields: [petReportId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([petReportId])
}

// Fase 2. Reusa ConfirmationType (mismo enum que ReportConfirmation) aunque
// la UI de mascotas nunca ofrezca "unsure" — evita un enum casi duplicado.
// Primera señal de confianza para mascotas, deliberadamente sin
// trustScore/decay — solo se cuenta confirm/incorrect al leer.
model PetConfirmation {
  id          String           @id @default(uuid())
  petReportId String
  userId      String
  type        ConfirmationType
  createdAt   DateTime         @default(now())

  petReport PetReport @relation(fields: [petReportId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([petReportId])
  @@index([userId])
  @@unique([petReportId, userId, type])
}

// "LA VI AQUÍ" — Fase 2. userId nunca null: igual que ReportConfirmation, un
// avistamiento sin sesión resuelve una identidad guest vía
// resolveGuestContact — a diferencia de PetShareEvent (telemetría pura, sí
// acepta anónimo real). Nunca se expone el autor en la UI (mismo criterio
// que needCommitments, que anonimiza a "un colaborador").
model PetSighting {
  id          String   @id @default(uuid())
  petReportId String
  userId      String
  lat         Float?
  lng         Float?
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  petReport PetReport @relation(fields: [petReportId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([petReportId])
  @@index([userId])
}

// Fase 3 ("quiero ayudar"). Distinto de PetHelpCategory (demanda) aunque los
// valores mayormente reflejen los mismos conceptos — este describe oferta.
enum PetResourceCategory {
  veterinary
  transport
  temporary_home
  attention_point
  rescue
  other
}

// Directorio "quiero ayudar", Fase 3. requireAuth para crear: ofrecer un
// servicio compromete tu identidad, a diferencia de reportar una mascota
// (que sigue siendo anónimo-friendly). Sin lat/lng — es cobertura de
// departamento/municipio (catálogo), no un pin exacto. Moderación
// (hidden/deletedAt) espeja PetReport, no Organization (que hoy no tiene
// ninguna de las dos).
model PetResource {
  id               String              @id @default(uuid())
  category         PetResourceCategory
  name             String
  description      String              @db.Text
  contactName      String
  contactEmail     String?
  contactPhone     String?
  departmentName   String
  municipalityName String
  availabilityNote String?
  createdById      String
  hidden           Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  createdBy User @relation("PetResourceCreatedBy", fields: [createdById], references: [id])

  @@index([category])
  @@index([departmentName, municipalityName])
  @@index([createdAt])
}
